# Global variable for password file path
PASSWORD_FILE="$HOME/.ussh.pw"

# Main logic
main() {
    local user_host
    local passwords
    local cmd_args=("$@")
    
    # Check for help options or no arguments
    if [[ $# -eq 0 ]] || [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
        show_usage
        exit 0
    fi
    
    # Handle -f option for custom password file
    if [[ "$1" == "-f" ]]; then
        if [[ $# -lt 2 ]]; then
            echo "Error: -f option requires a file path" >&2
            show_usage
            exit 1
        fi
        PASSWORD_FILE="$2"
        shift 2  # Remove -f and file path from arguments
        cmd_args=("$@")  # Update cmd_args after removing -f options
        
        # Check if we still have arguments after -f
        if [[ $# -eq 0 ]]; then
            echo "Error: No command specified after -f option" >&2
            show_usage
            exit 1
        fi
    fi
    
    # Handle --list option
    if [[ "$1" == "--list" ]]; then
        if [[ $# -ne 1 ]]; then
            echo "Error: --list option does not take any arguments" >&2
            show_usage
            exit 1
        fi
        list_entries
        exit 0
    fi
    
    # Handle --uninstall option
    if [[ "$1" == "--uninstall" ]]; then
        if [[ $# -ne 1 ]]; then
            echo "Error: --uninstall option does not take any arguments" >&2
            show_usage
            exit 1
        fi
        uninstall_script
        exit 0
    fi
    
    # Handle --install option
    if [[ "$1" == "--install" ]]; then
        if [[ $# -ne 1 ]]; then
            echo "Error: --install option does not take any arguments" >&2
            show_usage
            exit 1
        fi
        install_script
        exit 0
    fi
    
    # Handle --update option (after -f processing)
    if [[ "$1" == "--update" ]]; then
        if [[ $# -ne 3 ]]; then
            echo "Error: --update option requires exactly 2 arguments: user@host and password" >&2
            show_usage
            exit 1
        fi
        update_password "$2" "$3"
        exit 0
    fi
    
    # Handle --add option (after -f processing)
    if [[ "$1" == "--add" ]]; then
        if [[ $# -ne 3 ]]; then
            echo "Error: --add option requires exactly 2 arguments: user@host and password" >&2
            show_usage
            exit 1
        fi
        add_password "$2" "$3"
        exit 0
    fi
    
    # Handle --delete option (after -f processing)
    if [[ "$1" == "--delete" ]]; then
        if [[ $# -ne 2 ]]; then
            echo "Error: --delete option requires exactly 1 argument: user@host" >&2
            show_usage
            exit 1
        fi
        delete_passwords "$2"
        exit 0
    fi
    
    # Extract user@host from arguments
    user_host=$(extract_user_host "$@")
    
    if [[ -z "$user_host" ]]; then
        echo "Error: Could not find user@host in arguments" >&2
        show_usage
        exit 1
    fi
    
    # Get all passwords for user@host
    passwords=$(get_passwords "$user_host")
    
    if [[ -z "$passwords" ]]; then
        echo "Error: Password not found for $user_host" >&2
        exit 1
    fi
    
    # Handle SSH host key management
    handle_host_key "$user_host"
    
    # Determine if this is scp or ssh command
    local is_scp_command=false
    if [[ "$1" == "-c" ]]; then
        # scp command
        is_scp_command=true
        shift
        # For SCP, we need to replace the hostname in the arguments with user@host format
        local scp_args=()
        for arg in "$@"; do
            if [[ "$arg" =~ ^[^@:]+: ]] && [[ ! "$arg" =~ ^[^@]+@.*: ]]; then
                # This is a destination in format "hostname:" - convert to "user@hostname:"
                local hostname="${arg%%:*}"
                local path="${arg#*:}"
                if [[ "$user_host" =~ ^(.*)@${hostname}$ ]]; then
                    scp_args+=("${user_host}:${path}")
                else
                    scp_args+=("$arg")
                fi
            else
                scp_args+=("$arg")
            fi
        done
        cmd_args=("scp" "-o" "StrictHostKeyChecking=no" "-o" "UserKnownHostsFile=$HOME/.ssh/known_hosts" "${scp_args[@]}")
    else
        # ssh command - use the extracted user_host instead of original arguments
        cmd_args=("ssh" "-o" "StrictHostKeyChecking=no" "-o" "UserKnownHostsFile=$HOME/.ssh/known_hosts" "$user_host")
    fi
    
    # Try each password until one succeeds
    local working_password=""
    
    # First, find a working password
    while IFS= read -r password; do
        if [[ -n "$password" ]]; then
            echo "Testing password for $user_host..." >&2
            if test_password "$password" "$user_host"; then
                working_password="$password"
                echo "Found working password for $user_host" >&2
                break
            fi
        fi
    done <<< "$passwords"
    
    # Check if we found a working password
    if [[ -z "$working_password" ]]; then
        echo "Error: All passwords failed for $user_host" >&2
        exit 1
    fi
    
    # Move successful password to top for future use
    move_password_to_top "$user_host" "$working_password"
    
    # Now establish the interactive connection
    if [[ "$is_scp_command" == true ]]; then
        # Use SCP-specific function
        echo "Connecting via SCP..." >&2
        try_scp "$working_password" "${cmd_args[@]}"
        exit $?
    else
        # Use SSH-specific function for interactive session
        echo "Establishing SSH connection..." >&2
        try_connect "$working_password" "${cmd_args[@]}"
        # When SSH session ends, script will exit
        exit $?
    fi
}

# Call main function with all arguments
main "$@"